SECRET_KEY=change-me
DEBUG=True
# Database profile. Use "live" on cPanel/production.
DATABASE_PROFILE=local
# Optional host-level override. Leave blank to use DATABASE_PROFILE.
DATABASE_PROFILE_OVERRIDE=
PRIMARY_TENANT_HOSTS=virtuakids.com.ng
# Required when PRIMARY_TENANT_HOSTS should fall back and more than one school is active.
DEFAULT_SCHOOL_SLUG=

# Local PostgreSQL
LOCAL_DB_NAME=virtuakids_db
LOCAL_DB_USER=wisteen_virtuakids_user
LOCAL_DB_PASSWORD=your-local-password
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432

# cPanel PostgreSQL
LIVE_DB_NAME=cvtzapuk_sms
LIVE_DB_USER=cvtzapuk_smsuser
LIVE_DB_PASSWORD=your-live-password
LIVE_DB_HOST=localhost
LIVE_DB_PORT=5432

# Hosted domains
ALLOWED_HOSTS=virtuakids.com.ng,www.virtuakids.com.ng,.virtuakids.com.ng,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://virtuakids.com.ng,http://virtuakids.com.ng,https://www.virtuakids.com.ng,http://www.virtuakids.com.ng,https://*.virtuakids.com.ng,http://*.virtuakids.com.ng

# Optional integrations
GEMINI_API_KEY=your-gemini-api-key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Email and attendance notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=change-me
# Optional deployment-only override when EMAIL_HOST_PASSWORD is managed elsewhere.
EMAIL_HOST_PASSWORD_OVERRIDE=
DEFAULT_FROM_EMAIL=School Name <notifications@example.com>
EMAIL_TIMEOUT=15
TIME_ZONE=Africa/Lagos
# Optional shared key for the scanner API and Firebase service-account path.
ATTENDANCE_API_KEY=
FIREBASE_CREDENTIALS_PATH=

# Feature control setup command
FEATURE_CONTROL_ADMIN_PHONE=09125442676
FEATURE_CONTROL_ADMIN_PASSWORD=change-me

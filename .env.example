SECRET_KEY=change-me
DEBUG=True
PRODUCT_NAME=PastMaster SMS
PRODUCT_DOMAIN=sms.pastmaster.top
# Database profile. Use "live" on cPanel/production.
DATABASE_PROFILE=local
# Optional host-level override. Leave blank to use DATABASE_PROFILE.
DATABASE_PROFILE_OVERRIDE=
PRIMARY_TENANT_HOSTS=sms.pastmaster.top
# Required when PRIMARY_TENANT_HOSTS should fall back and more than one school is active.
DEFAULT_SCHOOL_SLUG=

# Local PostgreSQL
LOCAL_DB_NAME=pastmaster_sms_db
LOCAL_DB_USER=pastmaster_sms_user
LOCAL_DB_PASSWORD=your-local-password
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432

# cPanel PostgreSQL
LIVE_DB_NAME=pastmaster_sms
LIVE_DB_USER=pastmaster_sms_user
LIVE_DB_PASSWORD=your-live-password
LIVE_DB_HOST=localhost
LIVE_DB_PORT=5432

# Hosted domains
ALLOWED_HOSTS=sms.pastmaster.top,.sms.pastmaster.top,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://sms.pastmaster.top,http://sms.pastmaster.top,https://*.sms.pastmaster.top,http://*.sms.pastmaster.top

# Optional integrations
GEMINI_API_KEY=your-gemini-api-key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Email and attendance notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.pastmaster.top
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@sms.pastmaster.top
EMAIL_HOST_PASSWORD=change-me
# Optional deployment-only override when EMAIL_HOST_PASSWORD is managed elsewhere.
EMAIL_HOST_PASSWORD_OVERRIDE=
DEFAULT_FROM_EMAIL=PastMaster SMS <noreply@sms.pastmaster.top>
EMAIL_TIMEOUT=15
TIME_ZONE=Africa/Lagos
# Optional shared key for the scanner API and Firebase service-account path.
ATTENDANCE_API_KEY=
FIREBASE_CREDENTIALS_PATH=

# Feature control setup command
FEATURE_CONTROL_ADMIN_PHONE=09125442676
FEATURE_CONTROL_ADMIN_PASSWORD=change-me
